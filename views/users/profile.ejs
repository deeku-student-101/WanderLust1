<% layout("/layouts/boilerplate") %>

<div class="container mt-5">

    <h2 class="mb-4">👤 My Profile</h2>

    <div class="text-center mb-4">
        <img src="<%= currUser.profileImage %>"
             width="120"
             height="120"
             class="rounded-circle border">

        <h3 class="mt-3"><%= currUser.username %></h3>

        <p><%= currUser.email %></p>
    </div>

    <hr>

    <!-- ❤️ Liked Listings -->

    <h3 class="mb-3">❤️ Liked Listings</h3>

    <% if(likedListings.length === 0){ %>

        <div class="alert alert-secondary">
            You haven't liked any listing yet.
        </div>

    <% } else { %>

        <div class="row">

            <% likedListings.forEach((listing)=>{ %>

                <div class="col-md-4 mb-4">

                    <div class="card shadow h-100">

                        <img
                            src="<%= listing.image.url %>"
                            class="card-img-top"
                            style="height:200px; object-fit:cover;"
                        >

                        <div class="card-body">

                            <h5><%= listing.title %></h5>

                            <p class="text-muted">
                                📍 <%= listing.location %>,
                                <%= listing.country %>
                            </p>

                            <h6>₹ <%= listing.price.toLocaleString("en-IN") %></h6>

                            <a
                                href="/listings/<%= listing._id %>"
                                class="btn btn-dark btn-sm"
                            >
                                View Listing
                            </a>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

    <hr class="my-5">

    <!-- 📅 BOOKINGS -->

    <h3 class="mb-3">📅 My Bookings</h3>

    <% if(bookings.length === 0){ %>

        <div class="alert alert-secondary">
            No bookings found.
        </div>

    <% } else { %>

        <div class="row">

            <% bookings.forEach((booking)=>{ %>

                <div class="col-md-6 mb-4">

                    <div class="card shadow h-100">

                        <img
                            src="<%= booking.listing.image.url %>"
                            class="card-img-top"
                            style="height:200px; object-fit:cover;"
                        >
<div class="card-body ps-4">

    <h5><%= booking.listing.title %></h5>

    <p>
        📍 <%= booking.listing.location %>,
        <%= booking.listing.country %>
    </p>

    <p>Check In : <%= booking.checkIn.toDateString() %></p>

    <p>Check Out : <%= booking.checkOut.toDateString() %></p>

    <p>Guests : <%= booking.guests %></p>

    <p>Total Price : ₹<%= booking.totalPrice.toLocaleString("en-IN") %></p>

</div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>